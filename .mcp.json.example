{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=DEIN_PROJECT_REF"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "DEIN_PERSONAL_ACCESS_TOKEN"
      }
    }
  }
}
